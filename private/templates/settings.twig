{% extends "layout.twig" %}
{% block title %}Settings{% endblock %}
{% block body %}
<header class="border-bottom bg-white px-3 py-2">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <a href="/cp/" class="text-decoration-none text-body"><strong>Site editor</strong></a>
        <span class="text-secondary">/</span>
        <span>Settings</span>
        <div class="ms-auto d-flex align-items-center gap-2">
            {% include "_account_icons.twig" with { settings_active: true } %}
        </div>
    </div>
</header>
<div class="container py-4" style="max-width: 40rem;">
    <h1 class="h4 mb-3">Settings</h1>
    {% if flash %}
        <div class="alert alert-{{ flash.ok ? 'success' : 'danger' }}">{{ flash.message }}</div>
    {% endif %}
    <form method="post" action="/cp/settings" class="card card-body shadow-sm">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <div class="mb-3">
            <label class="form-label" for="api-key">OpenRouter API key</label>
            <input class="form-control font-monospace" id="api-key" name="api_key" type="text" value="{{ api_key }}" autocomplete="off" spellcheck="false">
            <div class="form-text">Saved to <code>config.ini</code>. Required for chat and image models.</div>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="form-label mb-0">Models</span>
            <button class="btn btn-sm btn-outline-secondary" type="button" id="refresh-models">Refresh from OpenRouter</button>
        </div>
        <p id="models-status" class="form-text mt-0 mb-3"></p>
        <div class="mb-3">
            <label class="form-label" for="chat-filter">Chat model</label>
            <input class="form-control form-control-sm mb-2" id="chat-filter" type="search" placeholder="Filter chat models" autocomplete="off">
            <select class="form-select" id="chat-model" name="chat_model" required>
                {% if chat_models is empty %}
                    <option value="{{ chat_model }}" selected>{{ chat_model }}</option>
                {% else %}
                    {% for m in chat_models %}
                        <option value="{{ m.id }}" {% if m.id == chat_model %}selected{% endif %}>{{ m.name }}{% if m.price %} ({{ m.price }}){% else %} ({{ m.id }}){% endif %}</option>
                    {% endfor %}
                {% endif %}
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label" for="image-filter">Image model</label>
            <input class="form-control form-control-sm mb-2" id="image-filter" type="search" placeholder="Filter image models" autocomplete="off">
            <select class="form-select" id="image-model" name="image_model" required>
                {% if image_models is empty %}
                    <option value="{{ image_model }}" selected>{{ image_model }}</option>
                {% else %}
                    {% for m in image_models %}
                        <option value="{{ m.id }}" {% if m.id == image_model %}selected{% endif %}>{{ m.name }}{% if m.price %} ({{ m.price }}){% else %} ({{ m.id }}){% endif %}</option>
                    {% endfor %}
                {% endif %}
            </select>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">Save</button>
            <a class="btn btn-outline-secondary" href="/cp/">Back to editor</a>
        </div>
    </form>
    <form method="post" action="/cp/settings/password" class="card card-body shadow-sm mt-4">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <h2 class="h6">Change password</h2>
        <p class="text-secondary small mb-3">Signed in as <strong>{{ username }}</strong>. The new password is saved to <code>config.ini</code> and used the next time you sign in.</p>
        <div class="mb-3">
            <label class="form-label" for="current-password">Current password</label>
            <input class="form-control" id="current-password" name="current_password" type="password" required autocomplete="current-password">
        </div>
        <div class="mb-3">
            <label class="form-label" for="new-password">New password</label>
            <input class="form-control" id="new-password" name="new_password" type="password" required minlength="8" maxlength="200" autocomplete="new-password">
            <div class="form-text">At least 8 characters.</div>
        </div>
        <div class="mb-3">
            <label class="form-label" for="confirm-password">Confirm new password</label>
            <input class="form-control" id="confirm-password" name="confirm_password" type="password" required minlength="8" maxlength="200" autocomplete="new-password">
        </div>
        <button class="btn btn-outline-primary" type="submit">Change password</button>
    </form>
    <div class="card card-body shadow-sm mt-4">
        <h2 class="h6">Diagnostic logs</h2>
        <p class="text-secondary small mb-3">Download a JSON file of application logs, the current chat, and server details. The API key and password are removed. Attach this file when something goes wrong.</p>
        <ul class="list-unstyled small mb-3">
            {% for file in log_files %}
                <li>
                    <span class="fw-medium">{{ file.label }}</span>
                    {% if file.exists %}
                        — {{ file.size }}{% if file.modified %}, {{ file.modified }}{% endif %}
                    {% else %}
                        — none yet
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
        <form method="post" action="/cp/settings/logs">
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <button class="btn btn-outline-primary" type="submit">Download logs</button>
        </form>
    </div>
</div>
{% endblock %}
{% block scripts %}
<script src="/cp/assets/settings.js"></script>
{% endblock %}
