# Optional Hestia include. Copy to:
# /home/Tash/conf/web/cp.dev.tashincconsulting.com/nginx.ssl.conf_sse
# then reload nginx.

location /cp/api/chat {
	proxy_ssl_server_name on;
	proxy_ssl_name $host;
	proxy_pass https://192.168.11.182:8443;
	proxy_buffering off;
	proxy_read_timeout 180s;
	proxy_send_timeout 180s;
}
